<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <UsingTask
    TaskName="NuGetConsoleMessageBox"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Reference Include="$(MSBuildFrameworkToolsPath)\System.Windows.Forms.dll" />
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.Windows.Forms" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        using (Process current = Process.GetCurrentProcess())
        {
            MessageBox.Show(
                "Inline C# executed inside " + current.ProcessName + ".exe",
                "LOLBAS Defensive Validation",
                MessageBoxButtons.OK,
                MessageBoxIcon.Information);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_IsProjectRestoreSupported" />
  <Target Name="_CollectRestoreInputs">
    <NuGetConsoleMessageBox />
  </Target>
</Project>
